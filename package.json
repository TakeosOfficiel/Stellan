{
  "name": "local-agent",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first coding agent for Windows and Linux",
  "author": "Local Agent contributors",
  "homepage": "https://ampcode.com/@takeos/AMP",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "pnpm build && electron-builder",
    "package:dir": "pnpm build && electron-builder --dir",
    "package:linux": "pnpm build && electron-builder --linux",
    "package:windows": "pnpm build && node scripts/package-windows.cjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "cross-spawn": "^7.0.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "systeminformation": "^5.33.6",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.4.0",
    "electron-builder": "24.9.1",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@12.0.0",
  "optionalDependencies": {
    "@vscode/ripgrep-linux-arm64": "1.18.0",
    "@vscode/ripgrep-linux-x64": "1.18.0",
    "@vscode/ripgrep-win32-arm64": "1.18.0",
    "@vscode/ripgrep-win32-x64": "1.18.0"
  }
}
